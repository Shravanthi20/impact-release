DATABASE_URL=sqlite:///./impactrelease.db
# stub = local fake PayPal (no credentials needed). sandbox = real PayPal sandbox.
PAYPAL_MODE=stub
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
APP_BASE_URL=http://localhost:8000

# LLM: offline needs no key. gemini uses the free tier from https://aistudio.google.com
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
HUMAN_APPROVAL_THRESHOLD=500
